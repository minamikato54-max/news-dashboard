<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>週次まとめ - ニュースダッシュボード</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
  :root { --primary: #2563eb; --bg: #f1f5f9; --text: #1e293b; --muted: #64748b; }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Hiragino Sans', sans-serif; background: var(--bg); color: var(--text); margin-left: 160px; }
  header { background: var(--primary); color: #fff; padding: 16px 20px; }
  header h1 { font-size: 1.2rem; }
  header .meta { font-size: 0.85rem; opacity: 0.85; margin-top: 4px; }
  .section { background: #fff; margin: 20px; border-radius: 12px; padding: 20px;
    box-shadow: 0 1px 4px rgba(0,0,0,.07); }
  .section h2 { font-size: 1rem; font-weight: bold; margin-bottom: 14px;
    padding-bottom: 8px; border-bottom: 2px solid #e2e8f0; }
  .summary-text { font-size: 0.92rem; line-height: 1.8; color: #374151; }
  .trend-chart-wrap { max-width: 600px; }
  .important-list { display: flex; flex-direction: column; gap: 12px; }
  .imp-card { border-left: 4px solid var(--primary); padding: 10px 14px;
    background: #f8fafc; border-radius: 0 8px 8px 0; }
  .imp-card .imp-cat { font-size: 0.78rem; color: var(--muted); margin-bottom: 4px; }
  .imp-card .imp-title { font-size: 0.9rem; font-weight: bold; margin-bottom: 6px; }
  .imp-card .imp-summary { font-size: 0.82rem; color: #374151; line-height: 1.5; margin-bottom: 6px; }
  .imp-card a { font-size: 0.82rem; color: var(--primary); text-decoration: none; }
  .imp-card a:hover { text-decoration: underline; }
  .stats { display: flex; gap: 16px; flex-wrap: wrap; }
  .stat-box { flex: 1; min-width: 120px; text-align: center; background: #f8fafc;
    border-radius: 8px; padding: 14px; }
  .stat-num { font-size: 1.8rem; font-weight: bold; color: var(--primary); }
  .stat-label { font-size: 0.8rem; color: var(--muted); margin-top: 4px; }
  /* サイドナビ */
  .side-nav { position: fixed; left: 0; top: 0; bottom: 0; width: 160px;
    background: #fff; border-right: 1px solid #e2e8f0; display: flex;
    flex-direction: column; z-index: 100; box-shadow: 2px 0 6px rgba(0,0,0,.08); }
  .side-nav-brand { padding: 16px 14px 14px; font-size: 0.85rem; font-weight: bold;
    color: var(--primary); border-bottom: 1px solid #e2e8f0; margin-bottom: 6px; }
  .side-nav a { display: block; padding: 13px 16px; color: var(--text);
    text-decoration: none; font-size: 0.88rem; border-left: 3px solid transparent;
    transition: all .15s; }
  .side-nav a:hover { background: #f1f5f9; color: var(--primary); }
  .side-nav a.active { background: #eff6ff; color: var(--primary);
    border-left-color: var(--primary); font-weight: bold; }
  footer { text-align: center; padding: 16px; font-size: 0.8rem; color: var(--muted); }

  /* --- モバイル対応 --- */
  .mobile-nav { display: none; position: fixed; bottom: 0; left: 0; right: 0;
    background: #fff; border-top: 1px solid #e2e8f0; z-index: 150;
    padding: 6px 0 max(6px, env(safe-area-inset-bottom)); }
  .mobile-nav-inner { display: flex; justify-content: space-around; }
  .mobile-nav a { display: flex; flex-direction: column; align-items: center;
    font-size: 0.72rem; color: var(--muted); text-decoration: none;
    padding: 4px 12px; gap: 2px; }
  .mobile-nav a.active { color: var(--primary); font-weight: bold; }
  .mobile-nav-icon { font-size: 1.3rem; line-height: 1; }
  @media (max-width: 640px) {
    body { margin-left: 0 !important; padding-bottom: 64px; }
    .side-nav { display: none; }
    .mobile-nav { display: block; }
    .section { margin: 10px 12px; padding: 14px; }
    .stats { gap: 10px; }
    .stat-box { min-width: 80px; padding: 10px; }
    .stat-num { font-size: 1.4rem; }
    header { padding: 12px 16px; }
    .trend-chart-wrap { max-width: 100%; }
  }
</style>
</head>
<body>

<nav class="side-nav">
  <div class="side-nav-brand">📰 ニュースDB</div>
  <a href="index.html">📅 今日</a>
  <a href="archive.html">📂 アーカイブ</a>
  <a href="weekly.html" class="active">📊 週次まとめ</a>
</nav>

<div class="mobile-nav">
  <div class="mobile-nav-inner">
    <a href="index.html"><span class="mobile-nav-icon">📅</span>今日</a>
    <a href="archive.html"><span class="mobile-nav-icon">📂</span>アーカイブ</a>
    <a href="weekly.html" class="active"><span class="mobile-nav-icon">📊</span>週次</a>
  </div>
</div>

<header>
  <h1>📊 週次まとめ</h1>
  <div class="meta">{{ week_start }} 〜 {{ week_end }}</div>
</header>

<div class="section">
  <h2>📝 今週のまとめ</h2>
  <p class="summary-text">{{ summary }}</p>
</div>

<div class="section">
  <h2>🔥 トレンドワード</h2>
  <div class="trend-chart-wrap">
    <canvas id="trendChart" height="200"></canvas>
  </div>
</div>

{% if important_articles %}
<div class="section">
  <h2>⭐ 今週の重要記事</h2>
  <div class="important-list">
    {% for a in important_articles %}
    <div class="imp-card">
      <div class="imp-cat">{{ a.date }} · {{ a.category }}</div>
      <div class="imp-title">{{ a.title }}</div>
      <div class="imp-summary">{{ a.summary }}</div>
      <a href="{{ a.url }}" target="_blank" rel="noopener">🔗 記事を読む</a>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

<div class="section">
  <h2>📈 今週の統計</h2>
  <div class="stats">
    <div class="stat-box">
      <div class="stat-num">{{ total }}</div>
      <div class="stat-label">今週の記事数</div>
    </div>
    <div class="stat-box">
      <div class="stat-num">{{ important_articles | length }}</div>
      <div class="stat-label">重要記事（★3）</div>
    </div>
  </div>
</div>

<footer>ニュースダッシュボード | 週次まとめ</footer>

<script>
const TREND_DATA = {{ trend_data | tojson }};
if (TREND_DATA && TREND_DATA.length) {
  new Chart(document.getElementById("trendChart"), {
    type: "bar",
    data: {
      labels: TREND_DATA.map(d => d.word),
      datasets: [{
        label: "記事内出現数",
        data: TREND_DATA.map(d => d.count),
        backgroundColor: "#2563eb99",
        borderColor: "#2563eb",
        borderWidth: 1,
      }]
    },
    options: {
      indexAxis: "y",
      plugins: { legend: { display: false } },
      scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
    }
  });
}
</script>
</body>
</html>
